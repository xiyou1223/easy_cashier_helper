@import '/app.wxss';

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #ffffff 0%, #f5f5f5 100%);
}

/* 顶部标题 */
.header {
  padding: 80rpx 40rpx 40rpx;
  text-align: center;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #ff6b35;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #999;
}

/* 入口按钮区域 */
.entry-buttons {
  flex: 1;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  justify-content: center;
}

/* 入口按钮通用样式 */
.entry-btn {
  background-color: white;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.btn-hover {
  transform: scale(0.96);
  opacity: 0.9;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 收银按钮 */
.cashier-btn {
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c5a 100%);
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 53, 0.3);
}

.cashier-btn .btn-icon,
.cashier-btn .btn-text,
.cashier-btn .btn-desc {
  color: white;
}

/* 商品管理按钮 */
.goods-btn {
  border: 2rpx solid #ff6b35;
}

.goods-btn .btn-icon {
  color: #ff6b35;
}

.goods-btn .btn-text {
  color: #333;
}

.goods-btn .btn-desc {
  color: #666;
}

/* 按钮图标 */
.btn-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

/* 按钮文字 */
.btn-text {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.btn-desc {
  font-size: 26rpx;
  opacity: 0.8;
}

/* 底部信息 */
.footer {
  padding: 40rpx;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: #ccc;
}
